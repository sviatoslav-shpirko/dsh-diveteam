#!/usr/bin/env bash
# Git Credential Helper wrapper for DiveTeam / DSH.
# Delegates `get` (and ignores `store`/`erase`) to `dsh-github-token` so Git
# authenticates to https://github.com using the token in RAM or KDE Wallet
# without ever writing the secret to disk.

set -euo pipefail

# Support DIVETEAM_GITHUB_TOKEN alongside FARVATER_GITHUB_TOKEN
if [ -n "${DIVETEAM_GITHUB_TOKEN:-}" ] && [ -z "${FARVATER_GITHUB_TOKEN:-}" ]; then
  export FARVATER_GITHUB_TOKEN="$DIVETEAM_GITHUB_TOKEN"
elif [ -n "${FARVATER_GITHUB_TOKEN:-}" ] && [ -z "${DIVETEAM_GITHUB_TOKEN:-}" ]; then
  export DIVETEAM_GITHUB_TOKEN="$FARVATER_GITHUB_TOKEN"
fi

REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
exec "$SCRIPT_DIR/dsh-github-token" "${1:-get}"
